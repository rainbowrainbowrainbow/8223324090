+                (business_context,name,description,price_type,price_per_child,duration_min)
+                VALUES ($1,$2,$3,'fixed',125,30) RETURNING id`,
+            [context, `${marker}-service`, marker])).rows[0].id;
+            row.graduationPackageSlug = `${key}_package`;
