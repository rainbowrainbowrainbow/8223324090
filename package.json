{
  "name": "event-genix",
  "version": "39.9.0",
  "description": "Event Genix — AI First CRM для дитячих розважальних центрів",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/api.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "db:migrate": "node db/migrate.js",
    "version:sync": "node scripts/version-sync.js --fix",
    "health": "curl -s http://localhost:3000/api/health | node -e \"process.stdin.on('data',d=>{const h=JSON.parse(d);console.log(h.status==='ok'?'✅ OK':'❌ '+h.status,h.version,'DB:'+h.database)})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
    "@supabase/supabase-js": "^2.98.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jsdom": "^29.0.1"
  }
}
