{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm run hermes:outbox:worker -- --mode=read_only_loop --include-stats=1 --batch-enabled=1 --batch-owner-ids=4",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
