{
  "name": "event-genix",
  "version": "43.17.0",
  "description": "Event Genix — AI First CRM для дитячих розважальних центрів",
  "main": "server.js",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run verify",
    "verify": "npm run check:runtime && npm run check:version && npm run check:migrations && npm run check:syntax && npm run test:unit && npm run test:ui",
    "check:runtime": "node scripts/check-runtime.js",
    "check:version": "node scripts/version-sync.js",
    "check:migrations": "node scripts/check-migrations.js",
    "check:syntax": "node scripts/check-js-syntax.js",
    "test:unit": "node --test tests/sql-safety.test.js tests/auth-boundary.test.js tests/user-seed-policy.test.js",
    "test:ui": "node tests/ui-check.js",
    "test:api": "node --test tests/api.test.js",
    "test:integration": "node --test tests/*.test.js",
    "db:migrate": "node db/migrate.js",
    "version:sync": "node scripts/version-sync.js --fix",
    "health": "curl -s http://localhost:3000/api/health | node -e \"process.stdin.on('data',d=>{const h=JSON.parse(d);console.log(h.status==='ok'?'✅ OK':'❌ '+h.status,h.version,'DB:'+h.database)})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
    "@supabase/supabase-js": "^2.98.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "devDependencies": {
    "jsdom": "^29.0.1"
  }
}
