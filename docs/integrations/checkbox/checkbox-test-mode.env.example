# EventGenix Checkbox test-mode environment manifest
#
# Do not paste real values into this file.
# Copy the variable names into the runtime secret manager and fill values there.
# Runtime credentials are ref-specific only: CHECKBOX_<REF>_*.

# Global gates. Keep production disabled until a separate activation task.
CHECKBOX_INTEGRATION_ENABLED=false
CHECKBOX_ACCEPT_PAYMENTS_ENABLED=false
CHECKBOX_WEBHOOK_ENABLED=false
EVENTGENIX_CASHIER_PRO_ENABLED=false

# Example credential ref:
#   register credential ref: park_middle_register_test
#   cashier credential ref:  park_middle_cashier_test
# Environment prefix normalization:
#   park_middle_register_test -> CHECKBOX_PARK_MIDDLE_REGISTER_TEST_*
#   park_middle_cashier_test  -> CHECKBOX_PARK_MIDDLE_CASHIER_TEST_*

CHECKBOX_PARK_MIDDLE_REGISTER_TEST_BASE_URL=
CHECKBOX_PARK_MIDDLE_REGISTER_TEST_LICENSE_KEY=
CHECKBOX_PARK_MIDDLE_REGISTER_TEST_ACCESS_KEY=
CHECKBOX_PARK_MIDDLE_REGISTER_TEST_DEVICE_ID=

CHECKBOX_PARK_MIDDLE_CASHIER_TEST_LOGIN=
CHECKBOX_PARK_MIDDLE_CASHIER_TEST_PASSWORD=

# Optional runtime identity guard. The fiscal register config also snapshots
# expected_is_test; test-mode QA must prove cashier.is_test === true before mutations.
CHECKBOX_EXPECT_IS_TEST=true

# Standalone sandbox/test-mode smoke. Uses exact official Checkbox HTTPS API host and
# refuses mutations unless exact test identity is configured and confirmed.
CHECKBOX_SANDBOX_BASE_URL=
CHECKBOX_SANDBOX_LOGIN=
CHECKBOX_SANDBOX_PASSWORD=
CHECKBOX_SANDBOX_LICENSE_KEY=
CHECKBOX_SANDBOX_ACCESS_KEY=
CHECKBOX_SANDBOX_DEVICE_ID=
# DEVICE_ID must stay stable for the same test register/cashier across restart and recovery.
CHECKBOX_SANDBOX_EXPECT_ORGANIZATION_ID=
CHECKBOX_SANDBOX_EXPECT_OUTLET_ID=
CHECKBOX_SANDBOX_EXPECT_REGISTER_ID=
CHECKBOX_SANDBOX_EXPECT_CASHIER_ID=
CHECKBOX_SANDBOX_EXPECT_IS_TEST=true
# Test-only proof escape hatch for Checkbox responses where cash_payment/card_payment
# are absent or null. It never overrides an explicit false permission and has no
# effect without exact test identity plus CHECKBOX_SANDBOX_CONFIRM_MUTATIONS=sandbox.
CHECKBOX_TEST_ALLOW_UNREPORTED_PAYMENT_PERMISSIONS=false
CHECKBOX_SANDBOX_TAX_CODE=
CHECKBOX_SANDBOX_AMOUNT_MINOR=1000
# Optional comma-separated proof scope: cash, card_terminal_manual. Default: both.
CHECKBOX_SANDBOX_TENDERS=cash,card_terminal_manual
CHECKBOX_SANDBOX_CONFIRM_MUTATIONS=
CHECKBOX_SANDBOX_INCLUDE_PRO=false
CHECKBOX_SANDBOX_CLOSE_SHIFT=false
CHECKBOX_SANDBOX_WEBHOOK_SECRET=

# Full-stack browser -> EventGenix -> disposable PostgreSQL -> real Checkbox
# test-mode proof. Run only through the npm scripts backed by the verified
# isolated PostgreSQL runner; never execute the browser harness file directly.
CHECKBOX_FULLSTACK_TESTMODE_CONFIG_FILE=
CHECKBOX_FULLSTACK_TESTMODE_STAGE=
CHECKBOX_FULLSTACK_TESTMODE_CONFIRM_MUTATIONS=
CHECKBOX_FULLSTACK_TESTMODE_CLOSE_SHIFT=false
CHECKBOX_FULLSTACK_TESTMODE_RUN_ID=
CHECKBOX_FULLSTACK_TESTMODE_RUN_LEDGER_DIR=
CHECKBOX_FULLSTACK_TESTMODE_RECOVERY_CONFIRM=
CHECKBOX_FULLSTACK_TESTMODE_FINAL_CLOSE_CONFIRM=
CHECKBOX_FULLSTACK_TESTMODE_RESUME_DRAFT_CONFIRM=

# Preflight is the default and performs no fiscal mutation:
#   npm run smoke:checkbox:testmode:fullstack:preflight
# Mutation, recovery, and final-card-close commands require a fresh explicit
# user authorization plus their exact one-shot confirmation values. The run ID
# must be a fresh UUID and the ledger directory must stay outside the repository.
# Allowed literals after that authorization are:
#   CHECKBOX_FULLSTACK_TESTMODE_CONFIRM_MUTATIONS=sandbox
#   CHECKBOX_FULLSTACK_TESTMODE_CLOSE_SHIFT=true
#   CHECKBOX_FULLSTACK_TESTMODE_RECOVERY_CONFIRM=card-only-after-fiscalized-cash
#   CHECKBOX_FULLSTACK_TESTMODE_FINAL_CLOSE_CONFIRM=one-card-canonical-close
#   CHECKBOX_FULLSTACK_TESTMODE_RESUME_DRAFT_CONFIRM=resume-one-local-unpaid-draft
# The last three are stage-specific; do not set them for unrelated runs.
# CHECKBOX_TEST_ALLOW_UNREPORTED_PAYMENT_PERMISSIONS=true is allowed only for an
# exact test identity after explicit approval. Any explicit provider permission=false
# still blocks the corresponding payment confirmation.
# Never reuse a completed/failed run ID or bypass the isolated runner guards.
