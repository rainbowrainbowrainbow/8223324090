diff --git a/services/gameZoneAccess.js b/services/gameZoneAccess.js
new file mode 100644
index 000000000..91af72dda
--- /dev/null
+++ b/services/gameZoneAccess.js
@@ -0,0 +1,19 @@
+'use strict';
+const { resolveCapability } = require('./accountAccessPolicy');
+const { timelineContextFromRequest } = require('./timelineContext');
+const { pool } = require('../db');
+async function loadGameZoneAccess(req, res, next) {
+    try {
+        req.user.gameZoneResourceIds = [];
+        const context = timelineContextFromRequest(req);
+        if (context !== 'event_genix'
+            || !resolveCapability(req.user, 'timeline.game_zones.view').allowed
+            || !resolveCapability(req.user, '/', { type: 'page' }).allowed) return next();
+        const result = await pool.query(`SELECT resource_id FROM timeline_resources
+            WHERE business_context = $1 AND type = 'room' AND is_active IS TRUE
+              AND metadata->>'workArea' = 'game_zone' ORDER BY resource_id`, [context]);
+        req.user.gameZoneResourceIds = result.rows.map(row => row.resource_id);
+        return next();
+    } catch (error) { return next(error); }
+}
+module.exports = { loadGameZoneAccess };
